# ---------------------------------------------------------------------------
# ENN Consultancy — Session Registration Platform
#
# Copy to .env.local for local development:      cp .env.example .env.local
# In production, set these in the Vercel project's Environment Variables.
# Never commit a filled-in .env file.
# ---------------------------------------------------------------------------


# === Firebase — client SDK (browser) =======================================
# Used ONLY for administrator sign-in with Firebase Authentication.
# These NEXT_PUBLIC_ values are the public web app configuration. They are meant
# to be visible in the browser; access is protected by Firestore security rules
# and by server-side verification of the resulting ID token, not by secrecy.
#
# Where to find them: Firebase console -> Project settings -> General ->
# Your apps -> Web app -> SDK setup and configuration.
#
# In Vercel, add these for Production, Preview and Development.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# === Firebase Admin SDK (server only) ======================================
# SECRET. These must never be exposed to the browser, and are deliberately not
# prefixed with NEXT_PUBLIC_, so Next.js will never bundle them client-side.
#
# Where to find them: Firebase console -> Project settings -> Service accounts
# -> Generate new private key. The downloaded JSON contains project_id,
# client_email and private_key.
#
# Setting these three switches the application from the local development store
# to Firestore. Leave them blank locally to use the file-backed dev store.
#
# FIREBASE_PRIVATE_KEY: paste the whole key including the BEGIN/END lines.
# Vercel stores the newlines escaped as \n; the app converts them back.
# Wrap the value in double quotes.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"


# === Administrator access ==================================================
# SECRET. Signs the admin session cookie. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — the app refuses to issue admin sessions without it.

ADMIN_SESSION_SECRET=

# Accounts permitted to administer, comma separated. When Firebase
# Authentication is enabled, a signed-in user is granted admin access if their
# email appears here OR their token carries the `admin` custom claim.
ADMIN_EMAILS=admin@ennconsultancy.com

# Fallback email/password sign-in, used when Firebase Auth is not configured.
# ADMIN_EMAIL must also be listed in ADMIN_EMAILS above if you use both.
# In production, leave these blank once Firebase Authentication is set up.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# === Application settings ==================================================
# Default timezone for newly created sessions. Each session also stores its own.
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# Canonical site URL, used for SEO and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app


# === Local development store (optional) ====================================
# Where the file-backed development store keeps its data. Ignored entirely once
# the Firebase Admin variables above are set.
# ENN_LOCAL_DB_PATH=.data/enn-dev-db.json


# === Email notifications ===================================================
# SMTP credentials for the confirmation emails sent on registration and on an
# in-house training request. Works with any provider: Google Workspace, Zoho,
# Microsoft 365, Amazon SES, Brevo, and so on.
#
# Leave blank and the application still works — messages are logged to the
# server console instead of being sent, and a mail outage never fails a
# registration that has already claimed a seat.
#
# Port 465 uses implicit TLS; 587 upgrades with STARTTLS.
# For Google Workspace / Gmail, SMTP_PASSWORD must be an App Password, not the
# account password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address the confirmation appears to come from. Defaults to SMTP_USER.
SMTP_FROM=info@ennconsultancy.com
SMTP_FROM_NAME=ENN Consultancy
# Optional: where replies should go, if different from the sending address.
SMTP_REPLY_TO=

# Optional: an internal copy of every registration and request is sent here.
ADMIN_NOTIFICATION_EMAIL=


# === Payment (UPI) =========================================================
# Paid sessions show a QR code with the payee, the exact fee and a transaction
# note already encoded, so registrants have nothing to type.
#
# These are NEXT_PUBLIC_ because the QR is rendered in the browser. A UPI ID is
# not a secret — it is the same identifier printed on a shop counter QR.
#
# If NEXT_PUBLIC_UPI_ID is left blank, the payment step falls back to showing
# the static image at public/payment-qr.png instead.

NEXT_PUBLIC_UPI_ID=ennconsultancy@okhdfcbank
NEXT_PUBLIC_UPI_PAYEE_NAME=ENN Consultancy
